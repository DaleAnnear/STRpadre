{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STRpadre caller configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "caller", "container", "tool_version", "platforms", "threads", "resources", "phased_reads_expected", "additional_args", "options"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "caller": {"enum": ["trgt", "longtr", "atarva", "strdust"]},
    "container": {"type": "string", "minLength": 1},
    "tool_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
    "reference_build": {"type": "string", "minLength": 1},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["hifi", "ont"]}},
    "native_catalog": {"type": "string", "minLength": 1},
    "native_catalog_index": {"type": "string", "minLength": 1},
    "threads": {"type": "integer", "minimum": 1},
    "resources": {"type": "object", "additionalProperties": false, "required": ["memory", "time"], "properties": {"memory": {"type": "string", "pattern": "^[1-9][0-9]* (MB|GB)$"}, "time": {"type": "string", "pattern": "^[1-9][0-9]*(m|h|d)$"}}},
    "phased_reads_expected": {"type": "boolean"},
    "additional_args": {"type": "array", "items": {"type": "string", "pattern": "^[^\\s;&|`$<>\\\\]+$"}},
    "options": {"type": "object"}
  }
}
