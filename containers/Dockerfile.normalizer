FROM mambaorg/micromamba:2.0.5@sha256:8d0d4cad074afe3ac93b58dce88bd2659153d3fa6de3a6968f501710e8d3c832

LABEL org.opencontainers.image.title="STRpadre normalizer and consensus utilities" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="local://STRpadre" \
      org.opencontainers.image.revision="pipeline-0.1.0"

USER root
RUN micromamba install --yes --name base --channel conda-forge --channel bioconda \
      python=3.12.11 pysam=0.23.0 pyyaml=6.0.2 jsonschema=4.23.0 bcftools=1.21 htslib=1.21 \
    && micromamba clean --all --yes
USER $MAMBA_USER
WORKDIR /work
