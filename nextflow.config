nextflow.enable.dsl = 2

params {
    samplesheet        = null
    reference          = null
    reference_fai      = null
    reference_dict     = null
    locus_manifest     = null
    callers            = null
    trgt_config        = 'configs/trgt.yml'
    longtr_config      = 'configs/longtr.yml'
    atarva_config      = 'configs/atarva.yml'
    strdust_config     = 'configs/strdust.yml'
    consensus_config   = 'configs/consensus.yml'
    trgt_container     = 'local/strpadre-trgt:5.1.0'
    longtr_container   = 'daleannear/strpadre:longtr-1.2-r1'
    atarva_container   = 'daleannear/strpadre:atarva-0.7.1-r1'
    strdust_container  = 'daleannear/strpadre:strdust-0.20.0-r1'
    normalizer_container = 'daleannear/strpadre:normalizer-1.0.0-r1'
    outdir             = 'results'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
    maxRetries = 0

    withLabel: validation {
        cpus = 1
        memory = '4 GB'
        time = '1h'
    }
    withLabel: catalog_adapter {
        cpus = 1
        memory = '2 GB'
        time = '1h'
    }
    withLabel: trgt {
        cpus = 4
        memory = '16 GB'
        time = '12h'
    }
    withLabel: longtr {
        cpus = 1
        memory = '12 GB'
        time = '24h'
    }
    withLabel: atarva {
        cpus = 4
        memory = '16 GB'
        time = '24h'
    }
    withLabel: strdust {
        cpus = 4
        memory = '8 GB'
        time = '12h'
    }
    withLabel: normalize {
        cpus = 1
        memory = '4 GB'
        time = '2h'
    }
    withLabel: consensus {
        cpus = 1
        memory = '6 GB'
        time = '2h'
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/reports/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/reports/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/reports/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/reports/dag.html"
    overwrite = true
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = "--user ${env('STRPADRE_DOCKER_UID')}:${env('STRPADRE_DOCKER_GID')}"
    }
    test {
        docker.enabled = false
        process.executor = 'local'
        process.cache = false
    }
}
